{
  "$schema": "https://opencode.ai/config.json",

  // OpenCode still owns scheduling and checkpoint installation.
  // A larger buffer starts automatic compaction earlier.
  "compaction": {
    "auto": true,
    "keep": { "tokens": 15000 },
    "buffer": 30000
  },

  "plugins": [
    {
      "package": "./plugins/jev-compaction",
      "options": {
        "enabled": true,
        "model": "jev-latest",

        "keepThreshold": 0.15,

        "preserveRecentMessages": 6,
        "minReductionRatio": 0.15,

        "toolResultPreviewChars": 300,
        "truncateHeadChars": 600,
        "maxStateChars": 100000,
        "maxStateTokens": 24000,
        "maxRequestTokens": 30000,
        "maxConcurrentRequests": 2,
        "timeoutMs": 6000,

        "enableCompareTool": true,
        "historyLimit": 10
      }
    }
  ]
}
