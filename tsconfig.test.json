{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": ".test-dist",
    "rootDir": ".",
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": [
    "src/domain/**/*.ts",
    "src/transcript/**/*.ts",
    "src/state/**/*.ts",
    "src/jev/**/*.ts",
    "src/policy/**/*.ts",
    "src/compaction/**/*.ts",
    "src/index.ts",
    "src/plugin/options.ts",
    "src/observability/history.ts",
    "src/observability/json.ts"
  ],
  "exclude": ["src/tui.ts"]
}
